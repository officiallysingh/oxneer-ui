{
  "permissions": {
    "allow": [
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Read",
      "Grep",
      "Glob",
      "Edit(/**)",
      "Read(//c/Users/bally/AppData/Local/Temp/claude/**)",
      "Edit(//c/Users/bally/AppData/Local/Temp/claude/**)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.js\"",
            "timeout": 30,
            "statusMessage": "Formatting with prettier"
          }
        ]
      }
    ]
  }
}
