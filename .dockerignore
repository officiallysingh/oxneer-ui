# Build context is the repo root (docker build -f apps/web/Dockerfile .).
# Keep host artifacts out: the image installs its own Linux node_modules,
# and host builds/caches/env files must not leak into the image.

# Dependencies (platform-specific binaries)
**/node_modules

# Build output and caches
**/.next
**/.turbo
**/dist
**/out
**/coverage
**/*.tsbuildinfo
**/.eslintcache

# Local env files (secrets / dev-only NEXT_PUBLIC_* values)
**/.env
**/.env.*
!**/.env.example

# Test artifacts
**/playwright-report
**/test-results
.playwright-mcp

# VCS, editor and agent tooling
.git
.github
.husky
.vscode
.idea
.claude
.codex
.cursor
.impeccable
**/*.log
