{
  "name": "oxneer",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:direct": "node scripts/dev.mjs",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@oxneer/config-eslint": "*",
    "@oxneer/config-prettier": "*",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --flag unstable_config_lookup_from_file --fix",
      "prettier -w"
    ],
    "*.{json,md,yaml,yml,css,scss}": [
      "prettier -w"
    ]
  }
}
